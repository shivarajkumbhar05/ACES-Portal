PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://quiz.example.com
TRUST_PROXY=1
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aces_quiz
JWT_ADMIN_SECRET=replace-with-a-long-random-admin-secret
JWT_STUDENT_SECRET=replace-with-a-different-long-random-student-secret
JWT_ADMIN_EXPIRES_IN=8h
JWT_STUDENT_EXPIRES_IN=3h
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
MAX_UPLOAD_SIZE_MB=5